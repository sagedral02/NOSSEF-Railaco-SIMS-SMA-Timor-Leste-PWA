{
  "name": "nossef-sims",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "start": "npm run build && node server/index.js",
    "reset-db": "node server/seed.js --force"
  },
  "dependencies": {
    "express": "^4.22.3",
    "lucide-react": "^1.57.0",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.15.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8",
    "vite": "^6.4.4"
  }
}
