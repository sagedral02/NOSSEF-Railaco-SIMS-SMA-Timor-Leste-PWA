# Copy to .env for local development. Never commit .env (PRD §38, F0-08).

# --- Django API (apps/api) ---
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgres://nossef:nossef_dev@localhost:5432/nossef
REDIS_URL=redis://localhost:6379/0
# PRD §52.2: run Celery tasks inline when Redis/worker are not running locally (never in production).
DEV_SYNC_TASKS=true
PRIVATE_STORAGE_ROOT=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@nossef.local
WEB_APP_URL=http://localhost:3000
LOG_LEVEL=INFO
DEMO_PASSWORD=nossef2026

# Feature flags (PRD §60.2)
ENABLE_LIBRARY=true
ENABLE_ASSETS=true
ENABLE_EXTRACURRICULAR=true
ENABLE_STAFF_ATTENDANCE=true
ENABLE_WEB_PUSH=false
ENABLE_EMAIL=false

# --- Next.js web (apps/web) ---
# Server-side origin of the Django API used by the Next.js rewrite proxy (same-origin cookies).
API_ORIGIN=http://127.0.0.1:8000
