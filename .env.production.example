# Copy to .env.production on the server (never commit). See docs/runbooks/deployment.md.
SITE_DOMAIN=sims.example.tl
DJANGO_SECRET_KEY=change-me-64-random-chars
DJANGO_ALLOWED_HOSTS=sims.example.tl
DJANGO_CSRF_TRUSTED_ORIGINS=https://sims.example.tl
DJANGO_HSTS_SECONDS=31536000
WEB_APP_URL=https://sims.example.tl
POSTGRES_DB=nossef
POSTGRES_USER=nossef
POSTGRES_PASSWORD=change-me
FIELD_ENCRYPTION_KEY=
# Optional integrations
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
DEFAULT_FROM_EMAIL=no-reply@sims.example.tl
ENABLE_EMAIL=false
ENABLE_WEB_PUSH=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sims.example.tl
REPORT_RETENTION_DAYS=7
